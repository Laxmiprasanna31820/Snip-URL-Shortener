# Copy this file to ".env" and edit. Everything is optional for local use.
PORT=3000

# Leave empty to use the local SQLite file (data/snip.db).
# Set it to use MongoDB Atlas (needed on Render's free tier, which loses local files).
MONGODB_URI=
MONGODB_DB=snip

# Optional: public URL used when building short links (e.g. https://yourapp.onrender.com)
BASE_URL=
